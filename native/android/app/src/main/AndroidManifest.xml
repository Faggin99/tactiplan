<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- "Exigir biometria ao abrir" (BiometricPrompt do sistema; permissão normal). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Loja: sem backup (cofre Tink nunca sai do aparelho — regras_*.xml), só HTTPS (o debug
         sobrepõe o network_security_config em src/debug) e nada de debuggable aqui.
         Push (FCM): estrutura pronta e DESLIGADA — o serviço só existe com google-services.json
         na build e só registra o token no servidor (sem pedir permissão de notificação ainda). -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/regras_extracao_dados"
        android:fullBackupContent="@xml/regras_backup"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="false"
        android:theme="@style/Tema.TactiPlan">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- T1: câmera (TakePicture grava aqui, sem permissão CAMERA), anexo baixado para ver e o PDF
             do relatório para a folha de compartilhar. Só pastas do cache (caminhos_arquivos.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.arquivos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/caminhos_arquivos" />
        </provider>

        <service
            android:name=".push.ServicoPush"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notificacao" />
    </application>
</manifest>
